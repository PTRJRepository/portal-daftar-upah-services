{
    "version": "1.0.0",
    "metadata": {
        "created_at": "2025-11-26",
        "description": "Centralized aggregation rules for payroll calculations",
        "author": "System",
        "last_updated": "2025-11-26"
    },
    "filter_rules": [
        {
            "field": "jumlah_hk",
            "operator": "gt",
            "value": 0,
            "description": "Filter out employees with 0 working days (HK = Hari Kerja)"
        }
    ],
    "row_calculations": [
        {
            "target_field": "total_tunjangan",
            "formula": "(beras_jumlah || 0) + (jabatan_jumlah || 0) + (masa_kerja_jumlah || 0) + (masa_kerja_amount || 0) + (lembur_jumlah || 0)",
            "description": "Calculate total allowances from rice, position, tenure, and overtime",
            "execution_order": 1
        },
        {
            "target_field": "total_premi",
            "formula": "(premi_brondol || 0) + (premi_pruning || 0) + (premi_dynamic_1 || 0) + (premi_dynamic_2 || 0) + (premi_dynamic_3 || 0) + (premi_dynamic_4 || 0) + (premi_dynamic_5 || 0) + (premi_dynamic_6 || 0) + (premi_dynamic_7 || 0)",
            "description": "Calculate total premiere from brondol, pruning, and dynamic premiere",
            "execution_order": 2
        },
        {
            "target_field": "total_potongan",
            "formula": "(pot_pph21 || 0) + (pot_koreksi || 0) + (pot_spsi || 0) + (pot_dynamic_1 || 0) + (pot_dynamic_2 || 0) + (pot_dynamic_3 || 0) + (pot_dynamic_4 || 0) + (pot_dynamic_5 || 0) + (pot_dynamic_6 || 0) + (pot_dynamic_7 || 0)",
            "description": "Calculate total deductions from tax, corrections, union, and dynamic deductions (BPJS excluded from POTONGAN)",
            "execution_order": 3
        },
        {
            "target_field": "jumlah_upah_kotor",
            "formula": "(gaji_pokok || 0) + (total_tunjangan || 0) + (total_premi || 0)",
            "description": "Calculate gross salary = base salary (from jumlah_hk) + allowances + premiere",
            "execution_order": 4
        },
        {
            "target_field": "upah_bersih",
            "formula": "(jumlah_upah_kotor || 0) - (total_potongan || 0)",
            "description": "Calculate net salary = gross salary - deductions",
            "execution_order": 5
        },
        {
            "target_field": "total_ketidakhadiran",
            "formula": "(cuti_tahunan_hari || 0) + (cuti_sakit_haid_hari || 0) + (cuti_minggu_hari || 0) + (cuti_nasional_hari || 0) + (tidak_hadir_cth || 0) + (tidak_hadir_alpa || 0)",
            "description": "Calculate total absences from all absence types",
            "execution_order": 0
        }
    ],
